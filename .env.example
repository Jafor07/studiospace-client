# Copy this file to .env.local and replace the example values.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/studiospace?retryWrites=true&w=majority
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:8000

# Required only for direct ImgBB photo uploads from the studio form.
NEXT_PUBLIC_IMGBB_API_KEY=
